PORT=5000
CLIENT_URL=http://localhost:5173
SITE_URL=https://coffeecodehub.com
MONGO_URI=mongodb://127.0.0.1:27017/coffeecodehub
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@coffeecodehub.com
ADMIN_PASSWORD=change-this-immediately
SEED_DEFAULTS=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@example.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ALLOW_LOCAL_UPLOADS=true
# Public backend URL used for local file URLs only; Cloudinary is required in production.
API_PUBLIC_URL=http://localhost:5000
